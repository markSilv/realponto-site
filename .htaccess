# REALPONTO INSTITUCIONAL - PRODUCAO
# Raiz: /home1/mar43964/public_html/.htaccess
# Usar SOMENTE apos HTTPS valido para realponto.com.br e www.realponto.com.br.
# Host canonico: https://www.realponto.com.br (igual ao canonical do index.html).
Options -Indexes -MultiViews
DirectoryIndex index.html

# Bloquear indexacao somente de hostnames temporarios, NAO do dominio oficial.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Host "^(marcosferreira1793107271154\.1870170\.meusitehostgator\.com\.br|br232\.teste\.website)(:[0-9]+)?$" RP_TEMPORARIO=1
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=RP_TEMPORARIO
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nao interceptar a renovacao AutoSSL por HTTP.
    RewriteRule ^\.well-known/(?:acme-challenge|pki-validation)(?:/|$) - [L]

    # Nao interceptar as aplicacoes existentes em subdiretorios.
    RewriteRule ^(?:jornada|previa-cliente)(?:/|$) - [L]

    # BEGIN REALPONTO LEGACY 301 - 2026-11-03
    # URLs do site antigo -> paginas equivalentes do site novo.
    # Antes da canonicalizacao: destino HTTPS + www + URL limpa em um salto.
    # Parametros de consulta sao preservados; demais caminhos nao sao alterados.
    # Categoria de relógios de ponto
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^relogios-de-ponto-digital/?$ https://www.realponto.com.br/relogio-de-ponto [R=301,L,NC]

    # Categoria de sistemas de ponto
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^softwares/?$ https://www.realponto.com.br/sistemas-em-nuvem [R=301,L,NC]

    # Controle de acesso consolidado em segurança eletrônica
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^controles-de-acesso/?$ https://www.realponto.com.br/seguranca-eletronica [R=301,L,NC]

    # Crachás e identificação visual
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^crachas/?$ https://www.realponto.com.br/identidade-visual [R=301,L,NC]

    # Suporte técnico RealPonto
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^servicos/suporte-realponto/?$ https://www.realponto.com.br/suporte-tecnico [R=301,L,NC]

    # Mesmo modelo: iDClass
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^relogios-de-ponto-digital/relogio-control-id-idclass/?$ https://www.realponto.com.br/paginas-relogios/relogio-idclass [R=301,L,NC]

    # Mesmo modelo: Inner REP Plus
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^relogios-de-ponto-digital/relogio-inner-rep-plus/?$ https://www.realponto.com.br/paginas-relogios/relogio-inner-rep [R=301,L,NC]

    # Mesmo modelo: Prisma SF ADV
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^relogios-de-ponto-digital/relogio-prisma-sf-adv/?$ https://www.realponto.com.br/paginas-relogios/relogio-prisma-sf-adv [R=301,L,NC]
    # END REALPONTO LEGACY 301

    # Redirecionar HTMLs diretos em um so passo para URL limpa e canonica.
    # THE_REQUEST evita loop depois de reescrita interna de /pagina para /pagina.html.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{THE_REQUEST} "\s/+index(?:\.html)?(?:[?\s])" [NC]
    RewriteRule ^index(?:\.html)?$ https://www.realponto.com.br/ [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{THE_REQUEST} "\s/+(?:paginas-relogios/)?[A-Za-z0-9_-]+\.html(?:[?\s])" [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)\.html$ https://www.realponto.com.br/$1 [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)/+$ https://www.realponto.com.br/$1 [R=301,L,NE]

    # Dominio sem www -> www, mantendo caminho e query string.
    RewriteCond %{HTTP_HOST} ^realponto\.com\.br$ [NC]
    RewriteRule ^ https://www.realponto.com.br%{REQUEST_URI} [R=301,L,NE]

    # Somente www em HTTP -> HTTPS. Nao altera a Jornada.
    RewriteCond %{HTTP_HOST} ^www\.realponto\.com\.br$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.realponto.com.br%{REQUEST_URI} [R=301,L,NE]

    # Recursos reais mantem seus caminhos e diretorios, inclusive subaplicacoes.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rotas institucionais sem extensao; arquivos HTML permanecem no disco.
    # Funciona no dominio definitivo e no endereco temporario da HostGator.
    # O link no menu continua SEM .html; somente o arquivo no disco tem extensao.
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)$ $1.html [END]
</IfModule>
