# REALPONTO INSTITUCIONAL - VALIDACAO ANTES DA TROCA DO DNS
# Raiz: /home1/mar43964/public_html/.htaccess
# Nao forca HTTPS ate existir certificado valido para o dominio e o www.
# Nao usar como configuracao final apos a migracao.
Options -Indexes -MultiViews
DirectoryIndex index.html

# Apenas os enderecos TEMPORARIOS de teste nao devem ser indexados.
# O dominio real e seu www nao recebem X-Robots-Tag noindex.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Host "^(marcosferreira1793107271154\.1870170\.meusitehostgator\.com\.br|br232\.teste\.website)(:[0-9]+)?$" RP_TEMPORARIO=1
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=RP_TEMPORARIO
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Renovacao AutoSSL: nao redirecionar o caminho de desafio HTTP.
    RewriteRule ^\.well-known/(?:acme-challenge|pki-validation)(?:/|$) - [L]

    # A Jornada e as outras aplicacoes independentes nao sao reescritas aqui.
    RewriteRule ^(?:jornada|previa-cliente)(?:/|$) - [L]

    # URLs institucionais: index(.html) -> raiz (apenas requisicao externa).
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{THE_REQUEST} "\s/+index(?:\.html)?(?:[?\s])" [NC]
    RewriteRule ^index(?:\.html)?$ / [R=302,L]

    # HTML existente -> URL limpa (redirecionamento temporario para testar).
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{THE_REQUEST} "\s/+(?:paginas-relogios/)?[A-Za-z0-9_-]+\.html(?:[?\s])" [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)\.html$ /$1 [R=302,L]

    # Barra final de uma pagina HTML existente -> versao sem barra.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)/+$ /$1 [R=302,L]

    # Preserva arquivos e diretorios reais (img, css, js, downloads, jornada).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Caminho sem extensao entrega o HTML sem alterar a URL no navegador.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?realponto\.com\.br$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)$ $1.html [L]
</IfModule>
