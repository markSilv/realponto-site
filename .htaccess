# SOMENTE NA PASTA DE HOMOLOGACAO. NUNCA USAR ESTE ARQUIVO EM PRODUCAO.
# Usar tambem Privacidade de diretorio no cPanel para proteger o teste com senha.
Options -Indexes -MultiViews
DirectoryIndex index.html
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store"
</IfModule>

# BEGIN REALPONTO URLS LIMPAS - TESTE
# Revisao temporaria: br232.teste.website/~mar43964/
# Aplicar somente em /home1/mar43964/public_html/.htaccess.
# SUBSTITUIR o bloco anterior; nao acumular as duas versoes.
# Arquivos continuam com .html. Nao usar este bloco no dominio definitivo.

Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On
RewriteBase /~mar43964/

# Diagnostico inofensivo: /rp-teste-rotas deve voltar a inicial com ?rp_rotas=ok.
RewriteRule ^rp-teste-rotas$ /~mar43964/?rp_rotas=ok [R=302,L]

# Acesso direto a index.html ou index -> raiz do site temporario.
# THE_REQUEST separa requisicoes do navegador de reescritas internas.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} "\s/+~mar43964/index(?:\.html)?/*(?:[?\s])" [NC]
RewriteRule ^index(?:\.html)?/*$ /~mar43964/ [R=302,L]

# Acesso direto a um HTML existente -> mesma pagina sem extensao.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} "\s/+~mar43964/(?:paginas-relogios/)?[A-Za-z0-9_-]+\.html(?:[?\s])" [NC]
RewriteCond /home1/mar43964/public_html/$1.html -f
RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)\.html$ /~mar43964/$1 [R=302,L]

# Remove barra final so de rotas com HTML correspondente (nao de pastas).
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond /home1/mar43964/public_html/$1.html -f
RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)/+$ /~mar43964/$1 [R=302,L]

# Nao altera imagens, estilos, scripts, downloads ou pastas reais.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rota sem extensao -> arquivo HTML, sem mudar o endereco do navegador.
# Caminho fisico explicito: nao depende do DocumentRoot do servidor compartilhado.
RewriteCond /home1/mar43964/public_html/$1.html -f
RewriteRule ^((?:paginas-relogios/)?[A-Za-z0-9_-]+)$ $1.html [L]
# END REALPONTO URLS LIMPAS - TESTE
